# Copy to `.env` and adjust for your machine.
#
#   cp .env.example .env
#
# All entries below are optional — defaults are sensible.

# --- Image source ---------------------------------------------------------
# Pull from GHCR by default. Set to your own tag to test a local build, or
# leave commented and run `docker compose build` to ignore the published image.
# IMAGE=ghcr.io/alpamayo-solutions/devcontainer:latest

# --- Networking -----------------------------------------------------------
# Host port that maps to sshd on container port 22.
SSH_PORT=2222

# --- Workspace ------------------------------------------------------------
# Host directory bind-mounted into the container as ~/work.
# This is where you `git clone` repos. Edits are visible on both sides.
WORK_DIR=/Users/till/Projects/devcontainer-workspace

# --- SSH key sources ------------------------------------------------------
# File containing the public keys allowed to log in. Mounted read-only;
# the entrypoint copies the contents into /home/dev/.ssh/authorized_keys
# with correct owner/mode. The host file is never modified.
#
# Default points to a file inside this checkout (gitignored). Populate it with:
#   ssh-add -L > authorized_keys                 # all keys in your ssh-agent
#   cat ~/.ssh/id_ed25519.pub > authorized_keys  # one specific key
AUTHORIZED_KEYS_FILE=./authorized_keys

# Optional: host .gitconfig to seed the container's git identity.
# Mounted read-only; the entrypoint copies it once per start. `git config
# --global` inside the container only ever modifies the in-container copy.
GITCONFIG_FILE=${HOME}/.gitconfig

# --- Container identity ---------------------------------------------------
CONTAINER_NAME=devcontainer
TZ=Europe/Zurich

# --- Build args (only used when building locally) -------------------------
NODE_MAJOR=22

# UID/GID of the in-container `dev` user.
# - macOS Docker Desktop: leave at 1000, VirtioFS handles ownership.
# - Linux hosts: set to your host UID to avoid permission churn:
#     DEV_UID=$(id -u) DEV_GID=$(id -g) docker compose build
DEV_UID=1000
DEV_GID=1000
