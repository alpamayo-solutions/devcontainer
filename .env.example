# Copy to `.env` and edit. WORK_DIR is the only required setting.

# Host directory bind-mounted as ~/work in the container — clone repos here.
WORK_DIR=/path/to/your/workspace

# Host port that maps to sshd on container :22
SSH_PORT=2222

# Pubkeys allowed to log in. Default: ./authorized_keys next to this .env.
# Generate it with: ssh-add -L > authorized_keys
# AUTHORIZED_KEYS_FILE=./authorized_keys

# Host gitconfig to seed the container's git identity (read-only mount).
# GITCONFIG_FILE=${HOME}/.gitconfig

# 1Password CLI: paste a service account token here to use `op` headlessly
# inside the container. Generate at https://my.1password.com → Service Accounts.
# OP_SERVICE_ACCOUNT_TOKEN=ops_...

# Misc
# CONTAINER_NAME=devcontainer
# TZ=Europe/Zurich
# IMAGE=ghcr.io/alpamayo-solutions/devcontainer:latest
